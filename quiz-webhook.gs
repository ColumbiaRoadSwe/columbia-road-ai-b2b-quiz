// Reads back the rows just written and fails loudly on any blank scoring cell.
function assertLastRowsPopulated_(n) {
  const ss    = SpreadsheetApp.openById(SHEET_ID);
  const sheet = ss.getSheetByName(SHEET_NAME);
  const last  = sheet.getLastRow();
  if (last < n + 1) { Logger.log('FAIL: expected at least ' + n + ' data rows, found ' + (last - 1)); return; }

  const rows = sheet.getRange(last - n + 1, 1, n, HEADERS.length).getValues();
  let bad = 0;
  rows.forEach(function (row, r) {
    REQUIRED_SCORING_COLS.forEach(function (name) {
      // 0 is a legitimate percentage — test for '' specifically, not falsiness.
      if (row[COLUMNS.indexOf(name)] === '') {
        Logger.log('FAIL: row ' + (last - n + 1 + r) + ' has blank "' + name + '"');
        bad++;
      }
    });
  });
  Logger.log(bad === 0
    ? 'PASS: ' + n + ' row(s) written, every scoring cell populated.'
    : 'FAIL: ' + bad + ' blank scoring cell(s).');
}

